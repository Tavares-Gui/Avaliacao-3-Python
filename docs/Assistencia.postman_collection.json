{
  "info": {
    "name": "Assistência Técnica - Defesa Django REST",
    "description": "Execute em ordem com o servidor local iniciado. Cria um cliente e uma ordem exclusivos, testa CRUD e erros e remove seus registros ao final. Os IDs são capturados automaticamente. O banco não precisa estar vazio.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "cliente_id",
      "value": ""
    },
    {
      "key": "ordem_id",
      "value": ""
    },
    {
      "key": "email_demo",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Criar cliente (captura ID)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/clientes/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Cliente da Defesa\",\n  \"email\": \"{{email_demo}}\",\n  \"telefone\": \"11987654321\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"email_demo\", \"defesa.\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"cliente_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Listar clientes",
